# Optional for public GitHub discovery; a token improves rate limits.
GITHUB_TOKEN=
# Required to enable Akta news and company enrichment.
AKTA_API_KEY=
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Peter's module registry factory; unset uses unavailable placeholders.
# GRADIENT_MODULE_FACTORY=your_package.modules:build_modules
# Synthetic integration testing only:
# GRADIENT_MODULE_FACTORY=gradient.integration.fixtures:build_modules
